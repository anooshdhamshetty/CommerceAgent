# Google Gemini (used by the query + reasoning agents)
# Get a free key at https://aistudio.google.com/apikey — no credit card needed
GEMINI_API_KEY=xxxxxxxx
GEMINI_MODEL=gemini-3.5-flash

# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Razorpay TEST MODE keys (Dashboard -> Settings -> API Keys, toggle Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx

# Merchant policy
BUDGET_AUTO_APPROVE_LIMIT=2000
MAX_QUERY_RETRIES=1
HALLUCINATION_TOLERANCE=0.01

# Frontend origin allowed to call this API
CORS_ORIGINS=http://localhost:5173
